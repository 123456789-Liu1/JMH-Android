# 签名配置模板
#
# 复制本文件为 keystore.properties 并填入你的签名信息。
# keystore.properties 已被 .gitignore 忽略，不会被提交到仓库。
#
# 如果你没有自己的签名文件，可以先生成一个：
#   keytool -genkeypair -v -keystore keystore/jmh-release.jks \
#     -alias jmh -keyalg RSA -keysize 2048 -validity 10950
#
# ⚠️ 重要：keystore 与密码一旦丢失，将无法再发布可覆盖安装的新版本。
#    请务必妥善备份（密码管理器 / 离线存储）。

storeFile=keystore/jmh-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
